# Client workspaces and plugins (everything specific to one client and owner:
# config.json, profile.md, plugin.py, scripts/, docs/, state/, output/, logs/).
# Only clients/README.md is tracked in git.
clients/*
!clients/README.md

# Legacy root paths (in case a tool creates one at root)
output/
logs/
state/
me/
config.json
config.json.bak
docs/
tmp/

# Built macOS installer packages (.dmg, .pkg, .zip, .app)
dist/

# Editor and other assistants' local settings
.cursor/
.codex/
.claude/settings.local.json

# Generated by install.sh / package_mac.sh
packaging/icon.png
packaging/icon.icns

.DS_Store
__pycache__/
*.pyc
